# Copy to .env and fill in to use Supabase instead of local JSON files.
# Without these the game stores everything under data/ and works fine for LAN play.

# Supabase > Project Settings > API > Project URL
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Supabase > Project Settings > API > service_role secret.
# Server-side only. Never expose this to a browser, and never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Hosts usually set this for you.
PORT=8080
